# Copia estas variables en Vercel → Settings → Environment Variables (NO subas un .env real al repositorio).

# Obligatorias
SESSION_SECRET=            # openssl rand -hex 32
APP_URL=https://tu-app.vercel.app
ADMIN_TOKEN=               # cadena larga aleatoria
RESEND_API_KEY=
EMAIL_FROM=ElaMath <hola@tudominio.com>
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# IA — hoy Groq; para pasar a Anthropic agrega ANTHROPIC_API_KEY y LLM_PROVIDER=anthropic
GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=groq        # groq | anthropic

# Cobro manual y prueba gratis — APAGADO por defecto (etapa de pruebas: todo abierto con cuenta).
# Para empezar a cobrar, descomenta la siguiente línea:
# BILLING_ENABLED=1
# TRIAL_DAYS=30
# PRO_PRICE_MXN=50
PAY_INSTRUCTIONS=Transfiere $50 MXN a la CLABE ____ (a nombre de ____) y mándanos tu correo de ElaMath por WhatsApp al ____.

# Límites (opcionales)
# TUTOR_PRO_DAILY=40
# TUTOR_TRIAL_DAILY=40
# TUTOR_FREE_DAILY=0
# TUTOR_GLOBAL_DAILY=2000

# Modelos (opcionales; los de Groq tienen vista previa en visión)
# GROQ_MODEL_FAST=llama-3.1-8b-instant
# GROQ_MODEL_STANDARD=llama-3.3-70b-versatile
# GROQ_MODEL_DEEP=openai/gpt-oss-120b
# GROQ_MODEL_VISION=qwen/qwen3.8-27b
