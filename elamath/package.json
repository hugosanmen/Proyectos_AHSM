{
  "name": "elamath",
  "version": "0.4.1",
  "description": "ElaMath — PWA de práctica de matemáticas para Ingeniería (prueba gratis, tutor IA, escáner, exámenes)",
  "scripts": {
    "build": "node tools/build.mjs",
    "build:public": "node tools/build.mjs --out public",
    "pretest": "node tools/build.mjs",
    "test": "node --test test/*.test.js",
    "dev": "node tools/dev-server.mjs",
    "e2e": "node tools/e2e.mjs",
    "serve": "npx --yes serve@14.2.4 -l 8080 public"
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.1.2",
    "katex": "0.18.11",
    "playwright-core": "^1.56.1"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": "22.x"
  }
}
